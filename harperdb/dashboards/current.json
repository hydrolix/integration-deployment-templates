            "pluginVersion": "4.8.1",
            "queryType": "time-series",
            "rawSql": "WITH top_threads AS (\n    SELECT thread, count() as total\n    FROM sbxhydrolixgoodson.harperlogs\n    WHERE $__timeFilter(timestamp)\n    GROUP BY thread\n    ORDER BY total DESC\n    LIMIT 10\n)\n\nSELECT\n    $__timeInterval(timestamp) as time,\n    thread,\n    count() as count\nFROM sbxhydrolixgoodson.harperlogs\nWHERE $__timeFilter(timestamp) AND thread IN (SELECT thread FROM top_threads)\nGROUP BY time, thread\nORDER BY time",
            "refId": "A"
          }
        ],
        "title": "Top 10 Threads by Log Volume",
        "transformations": [
          {

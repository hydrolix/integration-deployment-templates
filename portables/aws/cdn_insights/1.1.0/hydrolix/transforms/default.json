{
  "name": "default",
  "description": "Default pass-through transform for the CDN Insights common schema. Ingests JSON with fields already named to the implicit schema. No sql_transform, no field remapping.",
  "type": "json",
  "settings": {
    "is_default": true,
    "format_details": {
      "flattening": {
        "active": false,
        "depth": null
      }
    },
    "null_values": [
      "-"
    ],
    "output_columns": [
      {
        "name": "timestamp",
        "datatype": {
          "type": "epoch",
          "index": false,
          "primary": true,
          "format": "s",
          "resolution": "ms"
        }
      },
      {
        "name": "cache_was_cached",
        "datatype": {
          "type": "boolean",
          "index": true
        }
      },
      {
        "name": "client_asn",
        "datatype": {
          "type": "string",
          "index": true
        }
      },
      {
        "name": "client_city",
        "datatype": {
          "type": "string",
          "index": true
        }
      },
      {
        "name": "client_country_iso_code",
        "datatype": {
          "type": "string",
          "index": true
        }
      },
      {
        "name": "client_ip",
        "datatype": {
          "type": "string",
          "index": true
        }
      },
      {
        "name": "edge_ip",
        "datatype": {
          "type": "string",
          "index": true
        }
      },
      {
        "name": "edge_pop",
        "datatype": {
          "type": "string",
          "index": true
        }
      },
      {
        "name": "hdx_cdn",
        "datatype": {
          "type": "string",
          "index": true
        }
      },
      {
        "name": "hdx_source_latency_sec",
        "datatype": {
          "type": "uint32",
          "index": true
        }
      },
      {
        "name": "hdx_transform",
        "datatype": {
          "type": "string",
          "index": true,
          "default": "default"
        }
      },
      {
        "name": "origin_ip",
        "datatype": {
          "type": "string",
          "index": true
        }
      },
      {
        "name": "origin_time_to_first_byte_ms",
        "datatype": {
          "type": "uint64",
          "index": true
        }
      },
      {
        "name": "origin_time_to_last_byte_ms",
        "datatype": {
          "type": "uint64",
          "index": true
        }
      },
      {
        "name": "request_host",
        "datatype": {
          "type": "string",
          "index": true
        }
      },
      {
        "name": "request_method",
        "datatype": {
          "type": "string",
          "index": true
        }
      },
      {
        "name": "request_path",
        "datatype": {
          "type": "string",
          "index": true
        }
      },
      {
        "name": "request_query_string",
        "datatype": {
          "type": "string",
          "index": true
        }
      },
      {
        "name": "request_referer",
        "datatype": {
          "type": "string",
          "index": true
        }
      },
      {
        "name": "response_content_type",
        "datatype": {
          "type": "string",
          "index": true
        }
      },
      {
        "name": "response_status_code",
        "datatype": {
          "type": "string",
          "index": true
        }
      },
      {
        "name": "response_time_to_first_byte_ms",
        "datatype": {
          "type": "uint64",
          "index": true
        }
      },
      {
        "name": "response_time_to_last_byte_ms",
        "datatype": {
          "type": "uint64",
          "index": true
        }
      },
      {
        "name": "response_total_bytes",
        "datatype": {
          "type": "uint64",
          "index": true
        }
      },
      {
        "name": "user_agent",
        "datatype": {
          "type": "string",
          "index": true
        }
      },
      {
        "name": "user_agent_category",
        "datatype": {
          "type": "string",
          "index": true
        }
      },
      {
        "name": "is_origin_request",
        "datatype": {
          "type": "boolean",
          "index": true,
          "default": false
        }
      },
      {
        "name": "unknown",
        "datatype": {
          "type": "map",
          "index": true,
          "catch_all": true,
          "elements": [
            {
              "type": "string",
              "index": true
            },
            {
              "type": "string",
              "index": true
            }
          ]
        }
      }
    ]
  }
}

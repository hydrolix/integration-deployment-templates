        "id": 2,
        "options": {
          "code": {
            "language": "plaintext",
            "showLineNumbers": false,
            "showMiniMap": false
          },
          "content": "#### Raw Logs\n\nThis dashboard enables the user to review the last 1000 rows of raw logs. The time range is fixed to use the last 15 minutes of available data; changing the time range via the Grafana UI will not have any effect.\n\n\n\n\n\n",
          "mode": "markdown"
        },
        "pluginVersion": "12.0.0",
        "type": "text"
      },
      {
        "datasource": {
          "type": "hydrolix-hydrolix-datasource",
          "uid": "${DS_HYDROLIX-HYDROLIX-DATASOURCE}"
        },
        "gridPos": {
          "h": 17,
          "w": 24,
          "x": 0,
          "y": 2
        },
        "id": 1,
        "options": {
          "dedupStrategy": "none",
          "enableInfiniteScrolling": false,
          "enableLogDetails": true,
          "prettifyLogMessage": true,
          "showCommonLabels": false,
          "showLabels": false,
          "showTime": true,
          "sortOrder": "Descending",
          "wrapLogMessage": false
        },
        "pluginVersion": "12.0.0",
        "targets": [
          {
            "datasource": {
              "type": "hydrolix-hydrolix-datasource",
              "uid": "${DS_HYDROLIX-HYDROLIX-DATASOURCE}"
            },
            "format": 1,
            "rawSql": "SELECT *\nFROM ${table}\nWHERE ${timestamp} > now() - INTERVAL 15 MINUTE\nAND $__adHocFilter() \nORDER BY ${timestamp} DESC \nLIMIT 1000\nSETTINGS hdx_query_max_execution_time=60, hdx_query_admin_comment='db=${__dashboard}; dp=Raw Logs; du=${__user.login}'\n",
            "refId": "A"
          }
        ],
        "title": "Raw Logs",
        "type": "logs"
      }
    ],

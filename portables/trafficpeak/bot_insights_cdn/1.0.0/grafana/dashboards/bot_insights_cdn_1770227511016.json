    {
      "datasource": {
        "type": "hydrolix-hydrolix-datasource",
        "uid": "${DS_HYDROLIX-HYDROLIX-DATASOURCE}"
      },
      "description": "Understand how much of total request volume is originating from all bots as well as AI bots specifically",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 14,
        "x": 0,
        "y": 6
      },
      "id": 46,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "text": {},
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "datasource": {
            "type": "hydrolix-hydrolix-datasource",
            "uid": "${DS_HYDROLIX-HYDROLIX-DATASOURCE}"
          },
          "format": 1,
          "rawSql": "SELECT\n    cnt_all as \"Total Requests\",\n    countMergeIf(`count()`,is_bot_traffic = 1) AS \"Total Bot Requests\",\n    countMergeIf(`count()`,is_bot_traffic = 1 AND user_agent_category = 'AI LLM Crawler') AS \"AI Bot Requests\",\n    timestamp\nFROM \n    ${table}\nWHERE ${time}\n    AND $__adHocFilter()\nGROUP BY\n    timestamp\n    \nSETTINGS hdx_query_max_execution_time=60, hdx_query_admin_comment='db=${__dashboard}; dp=Traffic breakdown; du=${__user.login}'",
          "refId": "A"
        }
      ],
      "title": "Comparing Request Volumes",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "hydrolix-hydrolix-datasource",
        "uid": "${DS_HYDROLIX-HYDROLIX-DATASOURCE}"
      },
      "description": "What percentage of bot requests are served cached content from the CDN?",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-red"
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "#EAB839",
                "value": 0.5
              },
              {
                "color": "dark-green",
                "value": 0.8
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 5,
        "x": 14,
        "y": 6
      },
      "id": 63,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^cache_hit_rate$/",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "datasource": {
            "type": "hydrolix-hydrolix-datasource",
            "uid": "${DS_HYDROLIX-HYDROLIX-DATASOURCE}"
          },
          "format": 1,
          "rawSql": "SELECT \n  countMergeIf(`count()`, cache_was_cached AND is_bot_traffic) / countMergeIf(`count()`, is_bot_traffic) as cache_hit_rate\nFROM ${table}\nWHERE ${time}\n  AND $__adHocFilter()\nSETTINGS hdx_query_max_execution_time=60, hdx_query_admin_comment='db=${__dashboard}; dp=Offload by Hostname; du=${__user.login}'",
          "refId": "A"
        }
      ],
      "title": "Bot Requests Cache Hit Ratio",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "hydrolix-hydrolix-datasource",
        "uid": "${DS_HYDROLIX-HYDROLIX-DATASOURCE}"
      },
      "description": "What percentage of origin requests originate from bots?",
      "fieldConfig": {
        "defaults": {
          "color": {

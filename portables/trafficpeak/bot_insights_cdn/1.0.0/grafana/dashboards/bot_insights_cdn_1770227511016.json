      },
      "id": 66,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [],
          "fields": "/^bot_origin_load$/",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "datasource": {
            "type": "hydrolix-hydrolix-datasource",
            "uid": "${DS_HYDROLIX-HYDROLIX-DATASOURCE}"
          },
          "format": 1,
          "rawSql": "SELECT \n   countMergeIf(`count()`, is_bot_traffic AND NOT cache_was_cached) / countMergeIf(`count()`, not cache_was_cached) AS bot_origin_load\nFROM ${table}\nWHERE ${time}\n   AND $__adHocFilter()\nGROUP BY timestamp\n\nSETTINGS hdx_query_max_execution_time=60, hdx_query_admin_comment='db=${__dashboard}; dp=Offload by Hostname; du=${__user.login}'\n",
          "refId": "A"
        }
      ],
      "title": "Bot Share of Origin Requests",
      "type": "stat"
    },

          "rawSql": "SELECT \n  count() as \"Total Events\",\n  countIf(isOngoing = 'true') as \"Ongoing\",\n  countIf(eventType = 'attack') as \"Attacks\",\n  countIf(eventType = 'alert') as \"Alerts\",\n  round(avg(toUInt32OrZero(severity)), 0) as \"Avg Severity\",\n  max(toUInt32OrZero(severity)) as \"Max Severity\"\nFROM ${table} \nWHERE \n  $__timeFilter(timestamp) AND $__adHocFilter()\n  AND $__conditionalAll(eventType ${AND_eventType} (${eventType:sqlstring}), $eventType)\n  AND $__conditionalAll(service ${AND_service} (${service:sqlstring}), $service)\nSETTINGS hdx_query_max_execution_time=60, hdx_query_admin_comment='db=${__dashboard}; dp=Overview Stats; du=${__user.login}'",

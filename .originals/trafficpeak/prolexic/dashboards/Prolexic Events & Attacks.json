        {
          "datasource": {
            "type": "hydrolix-hydrolix-datasource",
            "uid": "${DS_HDX}"
          },
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT\n  count()               AS \"Total Events\",\n  max(preMitigationBps) AS \"Peak BPS\",\n  max(preMitigationPps) AS \"Peak PPS\",\n  uniq(accountId)       AS \"Unique Accounts\"\nFROM ${table}\nWHERE\n  $__timeFilter(timestamp) AND $__adHocFilter()\nSETTINGS hdx_query_max_execution_time=60, hdx_query_admin_comment='db=${__dashboard}; dp=Overview Stats; du=${__user.login}'",
          "refId": "A"
        }
      ],
      "title": "Overview Stats",
      "type": "stat"
    },

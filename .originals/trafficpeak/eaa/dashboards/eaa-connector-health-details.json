        "pluginVersion": "12.0.4",
        "targets": [
          {
            "datasource": {
              "type": "hydrolix-hydrolix-datasource",
              "uid": "__DATASOURCE__"
            },
            "format": 1,
            "rawSql": "SELECT\n  $__timeInterval(datetime) AS d,\n  name,\n  avg(cpu) as \"cpu_avg\", \n  avg(dialoutActive) as \"dialoutactive_avg\", \n  avg(dialoutIdle) as \"dialoutidle_avg\", \n  avg(network) as \"network_avg\",\n  avg(disk) as \"disk_avg\",\n  avg(mem) as \"mem_avg\"\n  FROM ${table}\n  WHERE $__timeFilter(datetime)\n  AND ${generalescaping}\n  AND $__adHocFilter() \nGROUP BY  d, name\nSETTINGS hdx_query_max_execution_time=60, hdx_query_admin_comment='db=${__dashboard}; dp=Users per APP; du=${__user.login}'",
            "refId": "A"
          }
        ],
        "title": "Connector Health_details",
        "transparent": true,
        "type": "canvas"
      },
      {
        "datasource": {
          "type": "hydrolix-hydrolix-datasource",
          "uid": "__DATASOURCE__"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "continuous-BlPu"
            },
            "mappings": [],
            "noValue": "Filter by only one connector",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green"
                }
              ]
            }
          },
          "overrides": []
        },
        "gridPos": {
          "h": 3,
          "w": 8,
          "x": 0,
          "y": 1
        },
        "id": 8,
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "percentChangeColorMode": "standard",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "/^name$/",
            "values": true
          },
          "showPercentChange": false,
          "textMode": "auto",
          "wideLayout": true
        },
        "pluginVersion": "12.0.4",
        "targets": [
          {
            "datasource": {
              "type": "hydrolix-hydrolix-datasource",
              "uid": "__DATASOURCE__"
            },
            "format": 1,
            "hide": false,
            "rawSql": "SELECT\n  name,\n  lastUpdate,\n  connUuid, debugchan, privateip, publicip,\n  osVersion, version, reachable,  \n  99 AS v\nFROM ${table}\nWHERE $__timeFilter(datetime)\n  AND ${generalescaping}\n  AND $__adHocFilter() \n  order by lastUpdate desc\n  limit 1  \nSETTINGS \n  hdx_query_max_execution_time=60, \n  hdx_query_admin_comment='db=${__dashboard}; dp=Connector; du=${__user.login}'",
            "refId": "A"
          },
          {
            "datasource": {
              "type": "hydrolix-hydrolix-datasource",
              "uid": "__DATASOURCE__"
            },
            "format": 1,
            "hide": false,
            "rawSql": "SELECT count(DISTINCT name) AS querycontroller, 99 as v\nFROM ${table}\nWHERE $__timeFilter(datetime)\n  AND ${generalescaping}\n  AND $__adHocFilter()\nSETTINGS hdx_query_max_execution_time=60, hdx_query_admin_comment='db=${__dashboard}; dp=Connector; du=${__user.login}'",
            "refId": "querycontroller"
          }
        ],
        "title": "Connector",
        "transformations": [
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "filterByValue",
            "options": {
              "filters": [
                {
                  "config": {
                    "id": "greater",
                    "options": {
                      "value": "1"
                    }
                  },
                  "fieldName": "querycontroller"
                }
              ],
              "match": "any",
              "type": "exclude"
            }
          },
          {
            "id": "filterFieldsByName",
            "options": {
              "include": {
                "names": [
                  "name"
                ]
              }
            }
          }
        ],
        "type": "stat"

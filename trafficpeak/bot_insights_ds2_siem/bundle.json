{
  "base_url": "https://github.com/hydrolix/integration-deployment-templates/blob/main/trafficpeak/bot_insights_ds2_siem",
  "beta": true,
  "dashboard": {
    "path": "dashboards/bot-insights-overview-alignment.json",
    "project_var": "__PROJECT_NAME__"
  },
  "dependencies": {
    "hydrolix": {
      "required_dictionaries": [
        "akamai_asn_type_dict",
        "akamai_bot_ip_dict",
        "akamai_ua_cat_dict"
      ],
      "required_functions": [
        "breadcrumbs",
        "cmcd_object_type",
        "cmcd_query_param",
        "cmcd_stream_type",
        "cmcd_streaming_format",
        "edge_worker",
        "edge_worker_execution",
        "extract_key_pair",
        "siem_extract"
      ],
      "shared_dictionaries": [],
      "shared_functions": []
    }
  },
  "metadata": {
    "channel_type": "3rdParty",
    "description": "DS2 + SIEM TrafficPeak Bot Insights bundle for Akamai logs.",
    "maintainer": "Hydrolix Team <team@hydrolix.io>",
    "version": "1.1.0"
  },
  "method": "multi_stream",
  "name": "trafficpeak_bot_insights_ds2_siem",
  "other_dashboards": [
    {
      "path": "dashboards/bot-insights-soc-what-changed.json",
      "project_var": "__PROJECT_NAME__"
    },
    {
      "path": "dashboards/bot-insights-edge-ops.json",
      "project_var": "__PROJECT_NAME__"
    },
    {
      "path": "dashboards/bot-insights-seo-governance.json",
      "project_var": "__PROJECT_NAME__"
    },
    {
      "path": "dashboards/bot-insights-multi-domain-triage.json",
      "project_var": "__PROJECT_NAME__"
    },
    {
      "path": "dashboards/bot-insights-what-changed-investigation.json",
      "project_var": "__PROJECT_NAME__"
    }
  ],
  "solution": true,
  "source": "trafficpeak",
  "summary_tables": [
    {
      "dashboard_var": "__BI_SUMMARY_MINUTE__",
      "name": "bi_summary_minute",
      "parent_table_name": "logs",
      "sql": {
        "path": "summaries/bi_summary_minute.sql"
      }
    },
    {
      "dashboard_var": "__BI_SUMMARY_HOUR__",
      "name": "bi_summary_hour",
      "parent_table_name": "logs",
      "sql": {
        "path": "summaries/bi_summary_hour.sql"
      }
    },
    {
      "dashboard_var": "__BI_SUMMARY_DAY__",
      "name": "bi_summary_day",
      "parent_table_name": "logs",
      "sql": {
        "path": "summaries/bi_summary_day.sql"
      }
    },
    {
      "dashboard_var": "__BI_SIEM_POLICY_SUMMARY_MINUTE__",
      "name": "bi_siem_policy_summary_minute",
      "parent_table_name": "siem",
      "sql": {
        "path": "summaries/bi_siem_policy_summary_minute.sql"
      }
    },
    {
      "dashboard_var": "__BI_SIEM_POLICY_SUMMARY_HOUR__",
      "name": "bi_siem_policy_summary_hour",
      "parent_table_name": "siem",
      "sql": {
        "path": "summaries/bi_siem_policy_summary_hour.sql"
      }
    },
    {
      "dashboard_var": "__BI_SIEM_POLICY_SUMMARY_DAY__",
      "name": "bi_siem_policy_summary_day",
      "parent_table_name": "siem",
      "sql": {
        "path": "summaries/bi_siem_policy_summary_day.sql"
      }
    }
  ],
  "tables": [
    {
      "dashboard_var": "__TABLE_NAME__",
      "name": "logs",
      "transforms": [
        {
          "path": "transformations/akamai_ds2/transform.json",
          "sample": "transformations/akamai_ds2/sample_data.json",
          "method": "http_streaming"
        }
      ]
    },
    {
      "dashboard_var": "__SIEM_TABLE_NAME__",
      "name": "siem",
      "transforms": [
        {
          "path": "transformations/siem/transform.json",
          "sample": "transformations/siem/sample_data.json",
          "method": "http_streaming"
        }
      ]
    }
  ],
  "ui": {
    "data_category": "security",
    "folder": "security",
    "method": {
      "full_title": "Http Streaming",
      "icon_url": "https://hydrolix-public.s3.us-east-2.amazonaws.com/partner_logos/http.png"
    },
    "primary_url": "https://docs.hydrolix.io/docs/bot-insights-ds2-integration",
    "source": {
      "full_title": "TrafficPeak Bot Insights DS2 + SIEM",
      "icon_url": "https://hydrolix-public.s3.us-east-2.amazonaws.com/partner_logos/trafficpeak.png"
    }
  }
}

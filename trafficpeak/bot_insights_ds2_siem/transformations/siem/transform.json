{
  "name": "siem",
  "type": "json",
  "settings": {
    "is_default": true,
    "rate_limit": null,
    "sql_transform": "SELECT\n    decodeURLComponent(requestHeadersStr) AS requestHeadersStr,\n    decodeURLComponent(responseHeadersStr) AS responseHeadersStr,\n    akamai_siem_extract(rulesStr) AS rules,\n    akamai_siem_extract(ruleTagsStr) AS ruleTags,\n    arrayResize(akamai_siem_extract(ruleDataStr), length(ruleTags), '') AS ruleData,\n    akamai_siem_extract(ruleActionsStr) AS ruleActions,\n    akamai_siem_extract(ruleMessagesStr) AS ruleMessages,\n    akamai_siem_extract(ruleVersionsStr) AS ruleVersions,\n    arrayResize(akamai_siem_extract(ruleSelectorsStr), length(ruleTags), '') AS ruleSelectors,\n    akamai_extract_key_pair(requestHeadersStr,'\n', ':') AS requestHeaders,\n    akamai_extract_key_pair(responseHeadersStr,'\n', ':') AS responseHeaders,\n    arrayExists(x -> multiSearchAny(x, ['AKAMAI/BOT/','BOT/','CUSTOM/BOT/','MBS_CL', 'AKAMAI/BOT/CUST_DEFINED_BOTS']), ruleTags) AS attack_bot,\n    arrayExists(x -> multiSearchAny(x, ['ASE/','AKAMAI/POLICY/','OWASP_CRS/','AKAMAI/WAF','AKAMAI/WEB_ATTACK/']), ruleTags) AS attack_waf,\n    arrayExists(x -> x = 'REPUTATION', ruleTags) AS attack_reputation,\n    arrayExists(x -> startsWith(x, '6'), rules) AS attack_custom,\n    arrayExists(x -> multiSearchAny(x, ['USER-RISK']), rules) AS attack_risk,\n    arrayExists(x -> x = 'IPBLOCK', ruleTags) AS attack_firewall,\n    arrayExists(x -> positionCaseInsensitive(x, 'BLOCK/') > 0, ruleTags) AS attack_dos,\n    arrayFilter((x, y) -> y = 1, ['Bot','WAF', 'Reputation','Custom','DoS', 'User Risk', 'Network Firewall'], [attack_bot, attack_waf,attack_reputation,attack_custom,attack_dos, attack_risk, attack_firewall]) AS attackTypes,\n    multiIf(\n arrayExists(x -> startsWith(x, 'Web Scrapers'), ruleMessages), 'Web Scrapers', \n arrayExists(x -> startsWith(x, 'Scanning Tools'), ruleMessages), 'Scanning Tools', \n arrayExists(x -> startsWith(x, 'Web Attackers'), ruleMessages), 'Web Attackers', \n arrayExists(x -> startsWith(x, 'DOS Attacker'), ruleMessages), 'DOS Attacker', \nNull) AS ruleMessage,\n    arrayDistinct(arrayFilter(x -> multiSearchAny(x, ['AKAMAI/BOT/','BOT/','CUSTOM/BOT/','MBS_CL',':']), ruleTags)) AS ruleTagsBot,\n    arrayDistinct(arrayFilter(x -> multiSearchAny(x, ['ASE/','AKAMAI/POLICY/','OWASP_CRS/','AKAMAI/WAF','AKAMAI/WEB_ATTACK/',':']), ruleTags)) AS ruleTagsWAF,\n    arrayDistinct(arrayFilter(x -> multiSearchAny(x, ['IPBLOCK',':']), ruleTags)) AS ruleTagsDOS,\n    requestHeaders['Sec-CH-UA'] AS CH_UA,\n    requestHeaders['User-Agent'] AS UA,\n    notEmpty(CH_UA) AS has_CH_UA,\n    datediff('s', timestamp, now64(3)) AS hdx_source_latency,\n    regexpExtract(requestHeadersStr, 'Referer:\\\\s*(\\\\S+)', 1) AS referer,\n    multiIf(\n arrayExists(x -> multiSearchAny(x, ['AKAMAI_CATEGORIZED']), ruleTags), 'Akamai',\n arrayExists(x -> multiSearchAny(x, ['CUST_DEFINED_BOTS']), ruleTags), 'Customer',\n 'Unknown') AS botType,\nbotType as bot_type,\n    multiIf(\n botData_responseSegment = 0, 'Human', \n botData_responseSegment > 0, 'Bot', \n 'empty') AS responseSegment,\n    multiIf(\n botData_responseSegment = 0, 'Human',\n botData_responseSegment = 1, 'Cautious response', botData_responseSegment = 2, 'Strict response', \n botData_responseSegment = 3, 'Aggressive response', botData_responseSegment = 4, 'Safeguard',\n 'empty') AS responseSegmentDetails,\n    multiIf(\n clientData_telemetryType = 0, 'Web client (standard telemetry)',\n clientData_telemetryType = 1, 'Web client (inline telemetry)',\n clientData_telemetryType = 2, 'Native app (SDK)',\n 'empty') AS telemetryType,\n    multiIf( indexOf(ruleTags, 'AKAMAI/BOT/AKAMAI_CATEGORIZED') > 0, indexOf(ruleTags, 'AKAMAI/BOT/AKAMAI_CATEGORIZED'),\n      indexOf(ruleTags, 'AKAMAI/BOT/CUST_DEFINED_BOTS') > 0, indexOf(ruleTags, 'AKAMAI/BOT/CUST_DEFINED_BOTS'),\n      indexOf(ruleTags, 'AKAMAI/BOT/UNKNOWN_BOT') > 0, indexOf(ruleTags, 'AKAMAI/BOT/UNKNOWN_BOT'), 0\n ) AS indexOfValues,\n    ruleData[indexOfValues] AS botnetId,\n    botnetId AS botnet_id,\n    ruleMessages[indexOfValues] AS botCategory,\n    botCategory AS bot_category,\n    *,\n    multiIf(arrayExists(x -> positionCaseInsensitive(x, 'deny') > 0 OR positionCaseInsensitive(x, 'block') > 0, ruleActions), 'deny', arrayExists(x -> positionCaseInsensitive(x, 'tarpit') > 0 OR positionCaseInsensitive(x, 'challenge') > 0 OR positionCaseInsensitive(x, 'delay') > 0 OR positionCaseInsensitive(x, 'serve_alt') > 0, ruleActions), 'mitigate', arrayExists(x -> positionCaseInsensitive(x, 'monitor') > 0 OR positionCaseInsensitive(x, 'alert') > 0, ruleActions), 'monitor', arrayExists(x -> positionCaseInsensitive(x, 'allow') > 0, ruleActions), 'allow', '') AS actionClass,\n    multiIf(arrayExists(x -> positionCaseInsensitive(x, 'Cookie authentication failed') > 0, ruleMessages), 'fail', '') AS authOutcome,\n    lower(cutQueryString(coalesce(path, ''))) AS requestPathNorm,\n    arrayStringConcat(arrayMap(segment -> multiIf(empty(segment), '', match(segment, '(?i)^[a-z0-9._-]+\\\\.(jpg|jpeg|png|gif|webp|avif|svg|css|js|mjs|map|woff|woff2|ttf|ico)([._-][a-z0-9]+)?$'), ':asset', match(segment, '^[0-9]+$'), ':num', match(segment, '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'), ':uuid', match(segment, '^[0-9a-f]{16,}$'), ':hex', match(segment, '^[a-z0-9][a-z0-9_-]{19,}$') AND match(segment, '[0-9]'), ':token', segment), splitByChar('/', requestPathNorm)), '/') AS requestPathPattern,\n    dictGet('akamai_ua_cat_dict', 'ua_category', assumeNotNull(UA)) AS userAgentCategory,\n    dictGet('akamai_ua_cat_dict', 'ai_category', assumeNotNull(UA)) AS aiCategory,\n    dictGet('akamai_ua_cat_dict', 'is_bot', assumeNotNull(UA)) AS isBotTraffic,\n    dictGet('akamai_ua_cat_dict', 'producer', assumeNotNull(UA)) AS botProducer,\n    if(notEmpty(aiCategory), botProducer, '') AS aiSource,\n    multiIf(positionCaseInsensitive(assumeNotNull(path), 'robots.txt') > 0, 'robots.txt', positionCaseInsensitive(assumeNotNull(path), 'sitemap.xml') > 0, 'sitemap.xml', positionCaseInsensitive(assumeNotNull(path), 'ads.txt') > 0, 'ads.txt', positionCaseInsensitive(assumeNotNull(path), 'llms.txt') > 0, 'llms.txt', match(assumeNotNull(path), '^/api/') OR match(assumeNotNull(path), '/api/'), 'api', match(assumeNotNull(path), '\\\\.(css|js|png|jpg|jpeg|gif|svg|ico|woff2?|ttf|eot)$'), 'static', match(assumeNotNull(path), '\\\\.(html?|php|asp|jsp)$') OR assumeNotNull(path) = '/' OR NOT match(assumeNotNull(path), '\\\\.'), 'page', 'other') AS resourceCategory\nFROM\n    {STREAM}",
    "null_values": [
      "-1",
      "^",
      "-"
    ],

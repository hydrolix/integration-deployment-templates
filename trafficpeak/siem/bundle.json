{
  "base_url": "https://github.com/hydrolix/integration-deployment-templates/blob/main/trafficpeak/siem",
  "beta": true,
  "dashboard": {
    "path": "dashboards/Akamai SIEM.json",
    "project_var": "__PROJECT_NAME__"
  },
  "dependencies": {
    "hydrolix": {
      "required_dictionaries": [],
      "required_functions": [],
      "shared_functions": [
        "breadcrumbs",
        "cmcd_object_type",
        "cmcd_stream_type",
        "cmcd_query_param",
        "cmcd_streaming_format",
        "edge_worker_execution",
        "edge_worker",
        "extract_key_pair",
        "siem_extract",
        "siem_trim_array"
      ]
    }
  },
  "metadata": {
    "channel_type": "AWS",
    "description": "SIEM TP Description",
    "maintainer": "kcorbett@hydrolix.io",
    "version": "1.0.0"
  },
  "method": "multi_stream",
  "method_overrides": {
    "region": "us-east-1",
    "stream_prefix": "aws-waf-logs-hdx"
  },
  "name": "multi_stream_tp_siem",
  "other_dashboards": [
    {
      "path": "dashboards/Security Analysis.json",
      "project_var": "__PROJECT_NAME__"
    },
    {
      "path": "dashboards/SIEM Raw Logs.json",
      "project_var": "__PROJECT_NAME__"
    }
  ],
  "solution": true,
  "source": "tp_siem",
  "tables": [
    {
      "dashboard_var": "__TABLE_NAME_SIEM__",
      "name": "siem",
      "transforms": [
        {
          "method": "http_streaming",
          "path": "transformations/siem/transform.json",
          "sample": "transformations/siem/sample_data.json"
        }
      ]
    },
    {
      "dashboard_var": "__TABLE_NAME_LOGS__",
      "name": "logs",
      "transforms": [
        {
          "method": "http_streaming",
          "path": "transformations/akamai_default_datastream/transform.json",
          "sample": "transformations/akamai_default_datastream/sample_data.json"
        }
      ]
    }
  ],
  "ui": {
    "data_category": "security",
    "method": {
      "full_title": "Http Streaming",
      "icon_url": "https://hydrolix-public.s3.us-east-2.amazonaws.com/partner_logos/http.png"
    },
    "primary_url": "https://docs.hydrolix.io/docs/cdn_insights-integration",
    "source": {
      "full_title": "TP SIEM",
      "icon_url": "https://hydrolix-public.s3.us-east-2.amazonaws.com/partner_logos/cdn_insights.png"
    }
  }
}

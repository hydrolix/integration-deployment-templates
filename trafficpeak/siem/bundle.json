{
  "base_url": "https://github.com/hydrolix/integration-deployment-templates/blob/main/trafficpeak/siem",
  "beta": true,
  "dashboard": {
    "path": "dashboards/Akamai SIEM.json",
    "project_var": "__PROJECT_NAME__"
  },
  "dependencies": {
    "hydrolix": {
      "required_dictionaries": [],
      "required_functions": [],
      "shared_dictionaries": [],
      "shared_functions": [
        "siem_extract",
        "extract_key_pair"
      ]
    }
  },
  "metadata": {
    "channel_type": "AWS",
    "description": "SIEM Trafficpeak Bundle Description",
    "maintainer": "kevin.borkman@hydrolix.io",
    "version": "0.0.9"
  },
  "method": "http_streaming",
  "name": "trafficpeak_siem",
  "other_dashboards": [
    {
      "path": "dashboards/Security Analysis.json",
      "project_var": "__PROJECT_NAME__"
    },
    {
      "path": "dashboards/SIEM Raw Logs.json",
      "project_var": "__PROJECT_NAME__"
    }
  ],
  "solution": true,
  "source": "trafficpeak",
  "tables": [
    {
      "dashboard_var": "__TABLE_NAME__",
      "name": "siem_logs",
      "transforms": [
        {
          "method": "http_streaming",
          "path": "transformations/transform.json",
          "sample": "transformations/sample_data.json"
        }
      ]
    }
  ],
  "ui": {
    "data_category": "security",
    "method": {
      "full_title": "Http Streaming",
      "icon_url": "https://hydrolix-public.s3.us-east-2.amazonaws.com/partner_logos/http.png"
    },
    "primary_url": "https://docs.hydrolix.io/docs/siem_trafficpeak-integration",
    "source": {
      "full_title": "SIEM",
      "icon_url": "https://hydrolix-public.s3.us-east-2.amazonaws.com/partner_logos/trafficpeak.png"
    }
  }
}

      },
      {
        "datasource": {
          "type": "hydrolix-hydrolix-datasource",
          "uid": "__DATASOURCE__"
        },
        "description": "Understand how much of total request volume is originating from all bots as well as AI bots specifically",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": 0
                }
              ]
            },
            "unit": "short"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 7,
          "w": 14,
          "x": 0,
          "y": 6
        },
        "id": 46,
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center",
          "orientation": "auto",
          "percentChangeColorMode": "standard",
          "reduceOptions": {
            "calcs": [
              "sum"
            ],
            "fields": "",
            "values": false
          },
          "showPercentChange": false,
          "text": {},
          "textMode": "auto",
          "wideLayout": true
        },
        "pluginVersion": "12.2.3",
        "targets": [
          {
            "datasource": {
              "type": "hydrolix-hydrolix-datasource",
              "uid": "__DATASOURCE__"
            },
            "format": 1,
            "rawSql": "SELECT\n    cnt_all as \"Total Requests\",\n    countMergeIf(`count()`,is_bot_traffic = 1) AS \"Total Bot Requests\",\n    countMergeIf(`count()`,is_bot_traffic = 1 AND user_agent_category = 'AI LLM Crawler') AS \"AI Bot Requests\",\n    timestamp\nFROM \n    ${table}\nWHERE ${time}\n    AND $__adHocFilter()\nGROUP BY\n    timestamp\n    \nSETTINGS hdx_query_max_execution_time=60, hdx_query_admin_comment='db=${__dashboard}; dp=Traffic breakdown; du=${__user.login}'",
            "refId": "A"
          }
        ],
        "title": "Comparing Request Volumes",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "hydrolix-hydrolix-datasource",
          "uid": "__DATASOURCE__"
        },
        "description": "What percentage of bot requests are served cached content from the CDN?",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "dark-red",
                  "value": 0
                },
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "#EAB839",
                  "value": 0.5
                },
                {
                  "color": "dark-green",
                  "value": 0.8
                }
              ]
            },
            "unit": "percentunit"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 7,
          "w": 5,
          "x": 14,
          "y": 6
        },
        "id": 63,
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center",
          "orientation": "auto",
          "percentChangeColorMode": "standard",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "/^cache_hit_rate$/",
            "values": false
          },
          "showPercentChange": false,
          "textMode": "auto",
          "wideLayout": true
        },
        "pluginVersion": "12.2.3",
        "targets": [
          {
            "datasource": {
              "type": "hydrolix-hydrolix-datasource",
              "uid": "__DATASOURCE__"
            },
            "format": 1,
            "rawSql": "SELECT\n  countMergeIf(`count()`, cacheStatus AND is_bot_traffic)\n    / nullIf(countMergeIf(`count()`, is_bot_traffic), 0)\n    AS cache_hit_rate  -- ✓ nullIf → NULL cuando no hay bot traffic\nFROM ${table}\nWHERE ${time}\n  AND $__adHocFilter()\nSETTINGS hdx_query_max_execution_time=60,\n    hdx_query_admin_comment='db=${__dashboard}; dp=Offload by Hostname; du=${__user.login}'",
            "refId": "A"
          }
        ],
        "title": "Bot Requests Cache Hit Ratio",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "hydrolix-hydrolix-datasource",
          "uid": "__DATASOURCE__"
        },
        "description": "What percentage of origin requests originate from bots?",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "red",
                  "value": 80
                }
              ]
            },
            "unit": "percentunit"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 7,
          "w": 5,
          "x": 19,
          "y": 6
        },
        "id": 66,
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "percentChangeColorMode": "standard",
          "reduceOptions": {
            "calcs": [],
            "fields": "/^bot_origin_load$/",
            "values": false
          },
          "showPercentChange": false,
          "textMode": "auto",
          "wideLayout": true
        },
        "pluginVersion": "12.2.3",
        "targets": [
          {
            "datasource": {
              "type": "hydrolix-hydrolix-datasource",
              "uid": "__DATASOURCE__"
            },
            "format": 1,
            "rawSql": "SELECT\n   countMergeIf(`count()`, is_bot_traffic AND NOT cacheStatus)\n     / nullIf(countMergeIf(`count()`, NOT cacheStatus), 0)\n     AS bot_origin_load,\n   timestamp\nFROM ${table}\nWHERE ${time}\n   AND $__adHocFilter()\nGROUP BY timestamp\nSETTINGS hdx_query_max_execution_time=60,\n    hdx_query_admin_comment='db=${__dashboard}; dp=Offload by Hostname; du=${__user.login}'\n",
            "refId": "A"
          }
        ],
        "title": "Bot Share of Origin Requests",
        "type": "stat"
      },

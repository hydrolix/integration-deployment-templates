          "pluginVersion": "10.4.1",
          "targets": [
            {
              "datasource": {
                "type": "grafana-clickhouse-datasource",
                "uid": "__DATASOURCE__"
              },
              "editorType": "sql",
              "format": 1,
              "meta": {
                "builderOptions": {
                  "columns": [],
                  "database": "",
                  "limit": 1000,
                  "mode": "list",
                  "queryType": "table",
                  "table": ""
                }
              },
              "pluginVersion": "4.0.6",
              "queryType": "table",
              "rawSql": "SELECT\n    (COUNT(CASE WHEN statusCode = 401 THEN 1 END) * 100) / COUNT(*) AS unauthorized_percentage\nFROM ${table}\nWHERE $__timeFilter(timestamp)",
              "refId": "A"

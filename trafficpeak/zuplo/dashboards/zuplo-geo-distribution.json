                "type": "dayNight"
              },
              {
                "config": {
                  "showLegend": true,
                  "style": {
                    "color": {
                      "field": "percentage_band",
                      "fixed": "dark-green"
                    },
                    "opacity": 0.4,
                    "rotation": {
                      "fixed": 0,
                      "max": 360,
                      "min": -360,

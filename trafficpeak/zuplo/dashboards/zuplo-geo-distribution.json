            "pieType": "pie",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "/^percentage$/",
              "limit": 10,
              "values": true
            },
            "tooltip": {
              "mode": "single",
              "sort": "none"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "grafana-clickhouse-datasource",
                "uid": "__DATASOURCE__"
              },
              "editorType": "sql",
              "format": 1,
              "meta": {
                "builderOptions": {
                  "columns": [],
                  "database": "",
                  "limit": 1000,
                  "mode": "list",
                  "queryType": "table",
                  "table": ""
                }
              },
              "pluginVersion": "4.0.6",
              "queryType": "table",
              "rawSql": "SELECT\n    colo AS colo_with_percentage,\n    request_count,\n    round((request_count * 100) / sum(request_count) OVER (), 2) AS percentage\nFROM (\n    SELECT\n        colo,\n        count() AS request_count\n    FROM ${table}\n    WHERE $__timeFilter(timestamp) AND colo != ''\n    GROUP BY colo\n)\nORDER BY request_count DESC",
              "refId": "A"
            }
          ],
          "title": "Traffic Distribution (Colo/IATA)",
          "transparent": true,
          "type": "piechart"
        }

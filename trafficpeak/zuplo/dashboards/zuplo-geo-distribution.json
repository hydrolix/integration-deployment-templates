              }
            ],
            "tooltip": {
              "mode": "none"
            },
            "view": {
              "allLayers": true,
              "id": "coords",
              "lat": 12.0028,
              "lon": 11.636296,
              "zoom": 2
            }
          },
          "pluginVersion": "10.4.1",
          "targets": [
            {
              "datasource": {
                "type": "grafana-clickhouse-datasource",
                "uid": "__DATASOURCE__"
              },
              "editorType": "sql",
              "format": 1,
              "meta": {
                "builderOptions": {
                  "columns": [],
                  "database": "",
                  "limit": 1000,
                  "mode": "list",
                  "queryType": "table",
                  "table": ""
                }
              },
              "pluginVersion": "4.0.6",
              "queryType": "table",
              "rawSql": "WITH grouped AS (\n    SELECT\n        round(toFloat64OrNull(latitude), 2) AS latitude,\n        round(toFloat64OrNull(longitude), 2) AS longitude,\n        count() AS request_count\n    FROM ${table}\n    WHERE $__timeFilter(timestamp)\n        AND toFloat64OrNull(latitude) IS NOT NULL\n        AND toFloat64OrNull(longitude) IS NOT NULL\n    GROUP BY latitude, longitude\n    ORDER BY request_count DESC\n    LIMIT 500\n)\nSELECT\n    latitude,\n    longitude,\n    CASE\n        WHEN percentage < 5 THEN 1\n        WHEN percentage < 10 THEN 2\n        WHEN percentage < 20 THEN 3\n        WHEN percentage < 30 THEN 4\n        WHEN percentage < 40 THEN 5\n        WHEN percentage < 50 THEN 6\n        WHEN percentage < 60 THEN 7\n        WHEN percentage < 70 THEN 8\n        WHEN percentage < 80 THEN 9\n        WHEN percentage < 90 THEN 10\n        WHEN percentage <= 100 THEN 11\n        ELSE 0\n    END AS percentage_band,\n    percentage\nFROM (\n    SELECT\n        latitude,\n        longitude,\n        round((request_count / sum(request_count) OVER ()) * 100, 2) AS percentage\n    FROM grouped\n)\nORDER BY percentage DESC",
              "refId": "Geo as Percentages"
            }
          ],
          "title": "Traffic Location Geo",
          "transparent": true,
          "type": "geomap"
        }
      },
      "becxq7ho7bmyod": {
        "name": "Zuplo: Traffic Distribution (Colo/IATA)",
        "uid": "becxq7ho7bmyod",
        "kind": 1,
        "model": {
          "datasource": {

                  "table": ""
                }
              },
              "pluginVersion": "4.0.6",
              "queryType": "table",
              "rawSql": "SELECT\n    $__timeInterval(timestamp) AS time,\n    quantile(0.5)(durationMs) AS median_duration,\n    avg(durationMs) AS average_duration,\n    quantile(0.95)(durationMs) AS p95_duration\nFROM ${table}\nWHERE $__timeFilter(timestamp)\nGROUP BY time\nORDER BY time ASC",

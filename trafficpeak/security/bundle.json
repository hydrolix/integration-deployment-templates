{
  "base_url": "https://github.com/hydrolix/integration-deployment-templates/blob/main/trafficpeak/security",
  "beta": true,
  "dashboard": {
    "path": "dashboards/DS2 Security Analysis.json",
    "project_var": "__PROJECT_NAME__"
  },
  "dependencies": {
    "hydrolix": {
      "required_dictionaries": [],
      "required_functions": [],
      "shared_functions": [
        "breadcrumbs",
        "cmcd_object_type",
        "cmcd_stream_type",
        "cmcd_query_param",
        "cmcd_streaming_format",
        "edge_worker_execution",
        "edge_worker",
        "edgeworker_edgeserverflow",
        "edgeworker_errorcode",
        "edgeworker_eventhandler",
        "edgeworker_offreason",
        "edgeworker_status",
        "extract_key_pair",
        "siem_extract"
      ]
    }
  },
  "metadata": {
    "channel_type": "AWS",
    "description": "Aggregates and analyzes security event data from multiple streams to provide comprehensive threat detection, monitoring, and incident response capabilities across your infrastructure.",
    "maintainer": "kcorbett@hydrolix.io",
    "version": "1.0.0"
  },
  "method": "http_streaming",
  "name": "tp_security",
  "other_dashboards": [
    {
      "path": "dashboards/DS2 Web Security.json",
      "project_var": "__PROJECT_NAME__"
    }
  ],
  "solution": true,
  "source": "tp_security",
  "tables": [
    {
      "dashboard_var": "__TABLE_NAME__",
      "name": "logs",
      "transforms": [
        {
          "method": "http_streaming",
          "path": "transformations/akamai_default_datastream.json",
          "sample": "transformations/sample_data.json"
        }
      ]
    }
  ],
  "ui": {
    "data_category": "security",
    "method": {
      "full_title": "Http Streaming",
      "icon_url": "https://hydrolix-public.s3.us-east-2.amazonaws.com/partner_logos/trafficpeak.png"
    },
    "primary_url": "https://docs.hydrolix.io/docs/cdn_insights-integration",
    "source": {
      "full_title": "Trafficpeak Security",
      "icon_url": "https://hydrolix-public.s3.us-east-2.amazonaws.com/partner_logos/trafficpeak.png"
    }
  }
}

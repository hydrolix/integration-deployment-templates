{
  "base_url": "https://github.com/hydrolix/integration-deployment-templates/blob/main/trafficpeak/china_cdn",
  "beta": true,
  "dashboard": {
    "path": "dashboards/CDN Dashboard Default.json",
    "project_var": "__PROJECT_NAME__"
  },
  "dependencies": {
    "hydrolix": {
      "required_dictionaries": [],
      "required_functions": [],
      "shared_dictionaries": [
        "ua_cat_dict"
      ],
      "shared_functions": [
        "city_name"
      ]
    }
  },
  "metadata": {
    "channel_type": "3rdParty",
    "description": "Trafficpeak China Cdn Integration",
    "maintainer": "Hydrolix Team <team@hydrolix.io>",
    "version": "1.0.0"
  },
  "method": "multi_stream",
  "name": "trafficpeak_china_cdn",
  "other_dashboards": [
    {
      "path": "dashboards/CDN Global View.json",
      "project_var": "__PROJECT_NAME__"
    },
    {
      "path": "dashboards/Raw Logs.json",
      "project_var": "__PROJECT_NAME__"
    }
  ],
  "solution": true,
  "source": "trafficpeak",
  "summary_tables": [
    {
      "dashboard_var": "__SUMMARY_TABLE_NAME_1__",
      "name": "tp_multi_summary_hour",
      "parent_table_name": "logs",
      "sql": {
        "path": "summaries/tp_multi_summary_hour.sql"
      }
    },
    {
      "dashboard_var": "__SUMMARY_TABLE_NAME_2__",
      "name": "tp_multi_summary_min",
      "parent_table_name": "logs",
      "sql": {
        "path": "summaries/tp_multi_summary_min.sql"
      }
    }
  ],
  "tables": [
    {
      "dashboard_var": "__TABLE_NAME__",
      "name": "logs",
      "transforms": [
        {
          "path": "transformations/byteplus/transform.json",
          "sample": "transformations/byteplus/sample_data.json",
          "method": "http_streaming"
        },
        {
          "path": "transformations/tencent/transform.json",
          "sample": "transformations/tencent/sample_data.json",
          "method": "http_streaming"
        }
      ]
    }
  ],
  "ui": {
    "data_category": "cdn",
    "method": {
      "full_title": "Http Streaming",
      "icon_url": "https://hydrolix-public.s3.us-east-2.amazonaws.com/partner_logos/http.png"
    },
    "primary_url": "https://techdocs.akamai.com/home",
    "source": {
      "full_title": "Trafficpeak China Cdn",
      "icon_url": "https://hydrolix-public.s3.us-east-2.amazonaws.com/partner_logos/trafficpeak.png"
    }
  }
}

            "rawSql": "SELECT\n    toStartOfInterval(toDateTime(timestamp), toIntervalSecond($__interval_ms / 1000)) AS time,\n    ${cnt_all_var} AS \"All Bot Requests\",\n    bot_category\nFROM ${table}\nWHERE ${time}\n    AND $__adHocFilter()\n    AND notEmpty(bot_type) = 1\nGROUP BY time, bot_category\nORDER BY time ASC, bot_category\nLIMIT 50000\nSETTINGS hdx_query_max_execution_time=60,\n    hdx_query_admin_comment='db=${__dashboard}; dp=Bot Request Volume by Category Over Time; du=${__user.login}'",

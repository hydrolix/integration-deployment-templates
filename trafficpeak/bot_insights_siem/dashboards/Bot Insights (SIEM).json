            "fields": "",
            "values": false
          },
          "showPercentChange": false,
          "textMode": "auto",
          "wideLayout": true
        },
        "pluginVersion": "12.2.3",
        "targets": [
          {
            "datasource": {
              "type": "hydrolix-hydrolix-datasource",
              "uid": "__DATASOURCE__"
            },
            "format": 1,
            "rawSql": "SELECT\n    ${cnt_all_var} as \"Total Requests\",\n    countMergeIf(`count()`, notEmpty(bot_type) = 1) AS \"Total Bot Requests\",\n    countMergeIf(`count()`, notEmpty(bot_type) = 1 AND bot_category = 'Artificial Intelligence (AI) Bots') AS \"AI Bot Requests\"\nFROM \n    ${table}\nWHERE ${time}\n    AND $__adHocFilter()\n    \nSETTINGS hdx_query_max_execution_time=60, hdx_query_admin_comment='db=${__dashboard}; dp=Traffic breakdown; du=${__user.login}'",
            "refId": "A"
          }
        ],
        "title": "Comparing Request Volumes",
        "type": "stat"
      },

            },
            "format": 1,
            "rawSql": "SELECT\n    t.1 AS name,\n    t.2 AS version,\n    t.3 AS osVersion,\n    t.4 AS privateip,\n    t.5 AS publicip,\n    t.6 AS reachable,\n    t.7 AS last_update\nFROM (\n    SELECT argMax(tuple(name, version, osVersion, privateip, publicip, reachable, lastUpdate), lastUpdate) AS t\n    FROM ${table}\n    WHERE $__timeFilter(datetime)\n      AND ${generalescaping}\n      AND $__adHocFilter()\n    GROUP BY name\n) sub\nORDER BY name ASC\nlimit ${querieslimit}\nSETTINGS hdx_query_max_execution_time=60,\n         hdx_query_admin_comment='db=${__dashboard}; dp=Connectors; du=${__user.login}'\n",
            "refId": "A"
          }
        ],

{
  "name": "multi_stream_cdn_insights",
  "source": "cdn_insights",
  "method": "multi_stream",
  "method_overrides": {
    "region": "us-east-1",
    "stream_prefix": "aws-waf-logs-hdx"
  },
  "beta": true,
  "solution": true,
  "base_url": "https://github.com/hydrolix/integration-deployment-templates/cdn_insights",
  "dashboard": {
    "path": "dashboards/CDN Dashboard Default.json",
    "project_var": "__PROJECT_NAME__"
  },
  "other_dashboards": [
    {
      "path": "dashboards/CDN Global View.json",
      "project_var": "__PROJECT_NAME__"
    },
    {
      "path": "dashboards/Raw Logs.json",
      "project_var": "__PROJECT_NAME__"
    }
  ],
  "dependencies": {
    "hydrolix": {
      "required_functions": [],
      "required_dictionaries": [],
      "shared_functions": [
        "city_name",
        "breadcrumbs",
        "country_iso_code",
        "geoname_id"
      ],
      "shared_dictionaries": [
        "geoip_asn_blocks_ipv4",
        "geoip_asn_blocks_ipv6",
        "geoip_city_blocks_ipv4",
        "geoip_city_blocks_ipv6",
        "geoip_city_locations_en",
        "ua_cat_dict"
      ]
    }
  },
  "tables": [
    {
      "dashboard_var": "__TABLE_NAME__",
      "name": "cdn_insights",
      "transforms": [
        {
          "path": "transformations/mcdn_akamai_ds2/transform.json",
          "method": "http_streaming"
        },
        {
          "path": "transformations/mcdn_cloudflare/transform.json",
          "method": "http_streaming"
        },
        {
          "path": "transformations/mcdn_cloudfront_firehose/transform.json",
          "method": "firehose"
        },
        {
          "path": "transformations/mcdn_fastly/transform.json",
          "method": "http_streaming"
        },
        {
          "path": "transformations/mcdn_tencent/transform.json",
          "method": "http_streaming"
        }
      ]
    }
  ],
  "summary_tables": [
    {
      "dashboard_var": "__SUMMARY_TABLE_NAME_1__",
      "name": "mcdn_summary_min",
      "parent_table_name": "cdn_insights",
      "sql": {
        "path": "summaries/mcdn_summary_min.sql"
      }
    },
    {
      "dashboard_var": "__SUMMARY_TABLE_NAME_2__",
      "name": "mcdn_summary_hour",
      "parent_table_name": "cdn_insights",
      "sql": {
        "path": "summaries/mcdn_summary_hour.sql"
      }
    }
  ],
  "ui": {
    "primary_url": "https://docs.hydrolix.io/docs/cdn_insights-integration",
    "method": {
      "full_title": "Http Streaming",
      "icon_url": "https://hydrolix-public.s3.us-east-2.amazonaws.com/partner_logos/http.png"
    },
    "source": {
      "full_title": "CDN Insights",
      "icon_url": "https://hydrolix-public.s3.us-east-2.amazonaws.com/partner_logos/cdn_insights.png"
    },
    "data_category": "security"
  },
  "metadata": {
    "version": "1.0.5",
    "maintainer": "kevin.borkman@hydrolix.io",
    "description": "CDN Insights Description",
    "channel_type": "AWS"
  }
}

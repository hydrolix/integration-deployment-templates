{
  "name": "mcdn_imperva",
  "description": "Imperva CDN/WAF transform for cdn-insights bundle (pre-parsed CEF to JSON)",
  "settings": {
    "is_default": false,
    "rate_limit": null,
    "sql_transform": "SELECT datediff('s', timestamp, now64(3)) AS hdx_source_latency_sec,\nresult_type LIKE 'REQ_CACHED%' AS cache_was_cached,\npath(concat('http://', assumeNotNull(request))) AS request_path,\nqueryString(concat('http://', assumeNotNull(request))) AS request_query_string,\nconcat(path(concat('http://', assumeNotNull(request))), IF(length(queryString(concat('http://', assumeNotNull(request)))) > 0, concat('?', queryString(concat('http://', assumeNotNull(request)))), '')) AS request_full_path,\ndictGet('__SHARED_PROJECT___ua_cat_dict', 'ua_category', assumeNotNull(user_agent)) AS user_agent_category,\nIF(isIPv6String(assumeNotNull(client_ip)), NULLIF(toString(dictGet('__SHARED_PROJECT___geoip_asn_blocks_ipv6', 'autonomous_system_number', IPv6StringToNumOrDefault(client_ip))),'0'), NULLIF(toString(dictGet('__SHARED_PROJECT___geoip_asn_blocks_ipv4', 'autonomous_system_number', toIPv4OrDefault(client_ip))),'0')) AS client_asn,\n * \nFROM {STREAM}",
    "null_values": [
      "-"
    ],

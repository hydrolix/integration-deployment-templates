{
  "name": "mcdn_tencent",
  "description": "Version v2.0",
  "settings": {
    "is_default": false,
    "rate_limit": null,
    "sql_transform": "SELECT\n  datediff('s', timestamp, now64(3)) AS hdx_source_latency_sec,\n  positionCaseInsensitive(result_type, 'hit') > 0 AS cache_was_cached,\n  __SHARED_PROJECT___city_name(client_ip) as client_city,\n  dictGet('__SHARED_PROJECT___ua_cat_dict', 'ua_category', assumeNotNull(user_agent)) AS user_agent_category,\n if(OriginResponseHeaderDuration >= 0, toUInt64(OriginResponseHeaderDuration), NULL) AS origin_time_to_first_byte_ms,\n *\nFROM {STREAM}",
    "null_values": [
      "-",
      "-1"
    ],

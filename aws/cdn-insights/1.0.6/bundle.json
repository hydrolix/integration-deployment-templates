{
  "base_url": "https://github.com/hydrolix/integration-deployment-templates/blob/main/aws/cdn-insights/1.0.6",
  "beta": true,
  "dashboard": {
    "path": "dashboards/CDN Dashboard Default.json",
    "project_var": "__PROJECT_NAME__"
  },
  "dependencies": {
    "hydrolix": {
      "required_dictionaries": [],
      "required_functions": [],
      "shared_dictionaries": [],
      "shared_functions": []
    }
  },
  "metadata": {
    "channel_type": "AWS",
    "description": "Aws Cdn Insights Integration",
    "maintainer": "Hydrolix Team <team@hydrolix.io>",
    "version": "1.0.6"
  },
  "method": "multi_stream",
  "name": "aws_cdn_insights",
  "other_dashboards": [
    {
      "path": "dashboards/CDN Global View.json",
      "project_var": "__PROJECT_NAME__"
    },
    {
      "path": "dashboards/Raw Logs.json",
      "project_var": "__PROJECT_NAME__"
    }
  ],
  "solution": true,
  "source": "aws",
  "summary_tables": [
    {
      "dashboard_var": "__SUMMARY_TABLE_NAME_1__",
      "name": "tp_multi_summary_hour",
      "parent_table_name": "cdn_insights_logs",
      "sql": {
        "path": "summaries/tp_multi_summary_hour.sql"
      }
    },
    {
      "dashboard_var": "__SUMMARY_TABLE_NAME_2__",
      "name": "tp_multi_summary_min",
      "parent_table_name": "cdn_insights_logs",
      "sql": {
        "path": "summaries/tp_multi_summary_min.sql"
      }
    }
  ],
  "tables": [
    {
      "dashboard_var": "__TABLE_NAME__",
      "name": "cdn_insights_logs",
      "transforms": [
        {
          "path": "transformations/tp_mcdn_cloudflare/transform.json",
          "sample": "transformations/tp_mcdn_cloudflare/sample_data.json",
          "method": "http_streaming"
        },
        {
          "path": "transformations/tp_mcdn_cloudfront_firehose/transform.json",
          "sample": "transformations/tp_mcdn_cloudfront_firehose/sample_data.json",
          "method": "firehose"
        },
        {
          "path": "transformations/tp_mcdn_fastly/transform.json",
          "sample": "transformations/tp_mcdn_fastly/sample_data.json",
          "method": "http_streaming"
        },
        {
          "path": "transformations/tp_mcdn_tencent/transform.json",
          "sample": "transformations/tp_mcdn_tencent/sample_data.json",
          "method": "http_streaming"
        }
      ]
    }
  ],
  "ui": {
    "data_category": "cdn",
    "method": {
      "full_title": "Http Streaming",
      "icon_url": "https://hydrolix-public.s3.us-east-2.amazonaws.com/partner_logos/http.png"
    },
    "primary_url": "https://docs.hydrolix.io/docs/cdn_insights-integration",
    "source": {
      "full_title": "Aws Cdn Insights",
      "icon_url": "https://hydrolix-public.s3.us-east-2.amazonaws.com/partner_logos/aws.png"
    }
  }
}

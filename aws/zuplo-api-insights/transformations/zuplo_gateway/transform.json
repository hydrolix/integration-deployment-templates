{
  "name": "zuplo_gateway",
  "description": "Zuplo gateway plugin-baseline transform",
  "type": "json",
  "settings": {
    "is_default": false,
    "compression": "",
    "format_details": {
      "flattening": {
        "active": false,
        "map_flattening_strategy": {
          "left": "",
          "right": ""
        },
        "slice_flattening_strategy": {
          "left": "",
          "right": ""
        },
        "depth": null
      }
    },
    "null_values": [
      "-",
      "-1",
      "^"
    ],
    "sql_transform": "SELECT\n  deployment_name_raw AS deployment_name,\n  request_id_raw AS request_id,\n  route_path_raw AS route_path,\n  operation_id_raw AS operation_id,\n  request_url_raw AS request_url,\n  nullIf(extract(ifNull(route_path_raw, ''), '^/v[0-9]+/([^/?]+)'), '') AS route_group,\n  method_raw AS request_method,\n  nullIf(extract(ifNull(request_url_raw, ''), 'https?://[^/]+([^?]*)'), '') AS request_path,\n  nullIf(extract(ifNull(request_url_raw, ''), '\\\\\\\\?(.*)$'), '') AS request_query,\n  nullIf(user_sub_raw, '') AS consumer_id,\n  CAST(NULL, 'Nullable(String)') AS api_key_id,\n  status_code_raw AS response_status_code,\n  duration_ms_raw AS gateway_latency_ms,\n  multiIf(\n    toUInt16(status_code_raw) = 401, 'auth_rejected',\n    notEmpty(ifNull(user_sub_raw, '')) AND lowerUTF8(ifNull(user_sub_raw, '')) != 'anonymous', 'authenticated',\n    'unknown'\n  ) AS auth_outcome,\n  multiIf(\n    toUInt16(status_code_raw) = 429, 'rate_limited',\n    'unknown'\n  ) AS rate_limit_outcome,\n  multiIf(\n    rate_limit_outcome = 'rate_limited', 'rate_limited',\n    auth_outcome = 'auth_rejected', 'auth_rejected',\n    toUInt16(status_code_raw) >= 500, 'gateway_error',\n    toUInt16(status_code_raw) >= 200 AND toUInt16(status_code_raw) < 400, 'served',\n    toUInt16(status_code_raw) >= 400 AND toUInt16(status_code_raw) < 500, 'client_error',\n    'unknown'\n  ) AS gateway_outcome,\n  client_ip_raw AS client_ip,\n  country_raw AS client_country,\n  asn_raw AS client_asn,\n  user_agent_raw AS user_agent,\n  instance_id_raw AS zuplo_instance_id,\n  colo_raw AS zuplo_colo,\n  city_raw AS zuplo_city,\n  continent_raw AS zuplo_continent,\n  latitude_raw AS zuplo_latitude,\n  longitude_raw AS zuplo_longitude,\n  postal_code_raw AS zuplo_postal_code,\n  metro_code_raw AS zuplo_metro_code,\n  region_raw AS zuplo_region,\n  region_code_raw AS zuplo_region_code,\n  timezone_raw AS zuplo_timezone,\n  as_organization_raw AS zuplo_as_organization,\n  *\nFROM {STREAM}",

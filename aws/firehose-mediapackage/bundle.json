{
  "base_url": "https://github.com/hydrolix/integration-deployment-templates/blob/main/aws/firehose-mediapackage",
  "beta": false,
  "dashboard": {
    "path": "dashboards/current.json",
    "project_var": "__PROJECT_NAME__"
  },
  "metadata": {
    "channel_type": "AWS",
    "description": "Amazon Elemental MediaPackage is a video delivery service that prepares and protects video streams for distribution to a variety of playback devices. It ingests live or on-demand video, packages it into multiple adaptive bitrate formats, and integrates with AWS services for content protection, scaling, and monitoring.",
    "maintainer": "jgoodson@hydrolix.io",
    "version": "1.0.0"
  },
  "method": "firehose",
  "name": "firehose-mediapackage",
  "source": "mediapackage",
  "tables": [
    {
      "dashboard_var": "__EGRESS_TABLE__",
      "name": "mediapackage_egress",
      "transforms": [
        {
          "path": "transformations/egress/current.json",
          "sample": "transformations/egress/sample_data_template.json"
        }
      ]
    },
    {
      "dashboard_var": "__INGRESS_TABLE__",
      "name": "mediapackage_ingress",
      "transforms": [
        {
          "path": "transformations/ingress/current.json",
          "sample": "transformations/ingress/sample_data_template.json"
        }
      ]
    },
    {
      "dashboard_var": "__METRICS_TABLE__",
      "name": "mediapackage_metrics",
      "transforms": [
        {
          "path": "transformations/metrics/current.json",
          "sample": "transformations/metrics/sample_data_template.json"
        }
      ]
    }
  ],
  "ui": {
    "data_category": "video",
    "method": {
      "full_title": "Amazon Data Firehose",
      "icon_url": "https://cascade-marketplace.s3.us-east-1.amazonaws.com/public/assets/icons/firehose.png"
    },
    "primary_url": "https://docs.hydrolix.io/latest/managed/data-sources/aws/aws-elemental-mediapackage/",
    "source": {
      "full_title": "AWS Elemental MediaPackage",
      "icon_url": "https://cascade-marketplace.s3.us-east-1.amazonaws.com/public/assets/icons/mediapackage.jpeg"
    }
  }
}

    "sql_transform": "SELECT \n  path(request_full_path) as request_path,\n  arrayMap(x -> splitByChar(':', x), splitByString('%0A', assumeNotNull(request_headers_string))) as request_headers_split,\n  arrayPopBack(arrayMap (y -> y[1], request_headers_split)) as request_header_names,\narrayPopBack(arrayMap(x -> decodeURLComponent(x), arrayMap(x -> replaceOne(x, ':',''), arrayMap(x -> extract(x,'^.[^:]*(.*)') ,splitByString('%0A', assumeNotNull(request_headers_string)))))) as request_header_values,\ndecodeURLComponent(assumeNotNull(response_content_type)) as response_content_type,\ndecodeURLComponent(assumeNotNull(request_user_agent)) as request_user_agent,\ndecodeURLComponent(assumeNotNull(request_referer)) as request_referer,\ndecodeURLComponent(assumeNotNull(decodeURLComponent(assumeNotNull(request_query_string)))) as request_query_string,\ndecodeURLComponent(assumeNotNull(decodeURLComponent(assumeNotNull(request_full_path)))) as request_full_path,\ndecodeURLComponent(assumeNotNull(cmcd_session_id)) as cmcd_session_id,\ndecodeURLComponent(assumeNotNull(decodeURLComponent(assumeNotNull(cmcd_next_object_request)))) as cmcd_next_object_request,\ndatediff('s', timestamp, now64(3)) as hdx_latency,\nif(client_ip_version = 'IPv6', true, false) as client_is_ipv6,\nconcat(toString(cf_range_start), '-', toString(cf_range_end)) as response_range,\ncf_time_taken * 1000 as response_time_to_last_byte,\norigin_fbl * 1000 as origin_first_byte_latency,\norigin_lbl * 1000 as origin_last_byte_latency,\ncf_response_time_to_first_byte * 1000 as response_time_to_first_byte,\n*\nFROM {STREAM}",

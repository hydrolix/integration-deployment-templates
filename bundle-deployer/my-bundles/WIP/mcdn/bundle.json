{
  "name": "http_streaming_mcdn_test",
  "source": "mcdn",
  "method": "http_streaming",
  "beta": true,
  "base_url": "https://github.com/hydrolix/integration-deployment-templates/blob/main/mcdn",
  
  "dependencies": {
    "hydrolix": {
      "required_functions": [
        {
          "name": "reference_breadcrumbs",
          "description": "Breadcrumbs extraction",
          "sql": "(breadcrumbs, mainregex, valuextract) -> nullIf(extract(extract(decodeURLComponent(assumeNotNull(breadcrumbs)), mainregex), valuextract),'')"
        }
      ]
    }
  },
  
  "tables": [
    {
      "dashboard_var": "__TABLE_NAME__",
      "name": "mcdn_test",
      "transforms": [
        { "path": "transformations/mcdn_akamai_ds2.json" },
        { "path": "transformations/mcdn_cloudflare.json" },
        { "path": "transformations/mcdn_cloudfront_firehose.json" },
        { "path": "transformations/mcdn_cloudfront_lsalv1.json" },
        { "path": "transformations/mcdn_fastly_config.json" },
        { "path": "transformations/mcdn_fastly.json" },
        { "path": "transformations/mcdn_tencent.json" }
      ]
    }
  ],
  
  "summary_tables": [
    {
      "dashboard_var": "__SUMMARY_TABLE_NAME_1__",
      "name": "mcdn_summary_min",
      "parent_table_name": "mcdn_test",
      "sql": { "path": "summaries/mcdn_summary_min.sql" }
    },
    {
      "dashboard_var": "__SUMMARY_TABLE_NAME_2__",
      "name": "mcdn_summary_hour",
      "parent_table_name": "mcdn_test",
      "sql": { "path": "summaries/mcdn_summary_hour.sql" }
    }
  ],
  
  "dashboard": {
    "path": "dashboards/CDN Dashboard Default-1760472868625.json",
    "project_var": "__PROJECT_NAME__"
  },
  
  "other_dashboards": [
    {
      "path": "dashboards/alert-rules-1760476335448.json",
      "project_var": "__PROJECT_NAME__"
    },
    {
      "path": "dashboards/CDN Global View-1760472910447.json",
      "project_var": "__PROJECT_NAME__"
    },
    {
      "path": "dashboards/Raw Logs-1760472918020.json",
      "project_var": "__PROJECT_NAME__"
    }
  ],
  
  "ui": {
    "primary_url": "https://docs.hydrolix.io/docs/mcdn_test-integration",
    "method": {
      "full_title": "Http-Streaming",
      "icon_url": "https://hydrolix-public.s3.us-east-2.amazonaws.com/partner_logos/http.png"
    },
    "source": {
      "full_title": "MCDN TEST",
      "icon_url": "https://hydrolix-public.s3.us-east-2.amazonaws.com/partner_logos/mcdn.png"

        "targets": [
          {
            "datasource": {
              "type": "hydrolix-hydrolix-datasource",
              "uid": "__DATASOURCE__"
            },
            "format": 1,
            "rawSql": "SELECT *\nFROM ${table}\nWHERE ${timestamp} > now() - INTERVAL 6 HOUR\nAND $__conditionalAll(host IN (${host:sqlstring}), $host)\nAND $__conditionalAll(method IN (${method:sqlstring}), $method)\nAND $__conditionalAll(status IN (${status:sqlstring}), $status)\nAND $__conditionalAll(country IN (${country:sqlstring}), $country)\nAND $__conditionalAll(clientIP IN (${clientIP:sqlstring}), $clientIP)\nAND $__conditionalAll(path IN (${path:sqlstring}), $path)\nAND $__conditionalAll(arrayJoin(ruleMessages)  ILIKE '%${message}%', $message)\nAND $__conditionalAll(arrayJoin(ruleTags) ILIKE '%${tags}%', $tags)\nAND $__conditionalAll(arrayJoin(ruleActions) ILIKE '%${ruleActions}%', $ruleActions)\nAND if ('${requestHeadersName:text}' = '', true, mapContainsKeyLike(requestHeaders, '%${requestHeadersName:text}%'))\nAND if ('${responseHeadersName:text}' = '', true, mapContainsKeyLike(responseHeaders, '%${responseHeadersName:text}%'))\nORDER BY ${timestamp} DESC \nLIMIT 1000\nSETTINGS hdx_query_max_execution_time=60, hdx_query_admin_comment='db=${__dashboard}; dp=Raw Logs; du=${__user.login}'\n",
            "refId": "A"
          }
        ],
        "timeFrom": "6h",
        "title": "Raw Logs (Click ↗️  to view and edit the SQL in Explore (Logs View))",
        "type": "logs"
